{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "crazybooot/base64-validation": "^1.0.12",
        "doctrine/migrations": "^3.4",
        "dyrynda/laravel-model-uuid": "^8.1.1",
        "filament/actions": "^3.0",
        "filament/forms": "^3.0",
        "filament/support": "^3.0",
        "filament/tables": "^3.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.6",
        "laravel/breeze": "^2.0",
        "laravel/framework": "^11.15",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "livewire/livewire": "^3.4",
        "propaganistas/laravel-phone": "^5.2",
        "pusher/pusher-php-server": "^7.0",
        "schmeits/filament-character-counter": "^1.3.4",
        "spatie/laravel-cookie-consent": "^3.2",
        "spatie/laravel-onboard": "^2.4",
        "spatie/laravel-webhook-client": "^3.1",
        "stancl/virtualcolumn": "^1.2",
        "staudenmeir/laravel-merged-relations": "^1.0",
        "wire-elements/modal": "^3.0",
        "ysfkaya/filament-phone-input": "^3.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.10",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan filament:upgrade",
            "@php artisan ide-helper:generate -M -H", 
            "@php artisan ide-helper:models --dir='app/Models' -M"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
